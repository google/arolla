{%- from 'io_utils.jinja2' import type_in_order_vector -%}

{%- macro accessors_listener(accessors) -%}

template <class Fn>
using accessor_lambda_result_t = std::decay_t<::arolla::meta::head_t<
    typename ::arolla::meta::function_traits<Fn>::arg_types>>;

template <class Fn>
Status CallAccessor(const Fn& fn, ConstFramePtr frame, size_t offset,
                    Output* output) {
  using result_t = accessor_lambda_result_t<Fn>;
  const auto& val =
      frame.Get(FrameLayout::Slot<result_t>::UnsafeSlotFromOffset(offset));
  if constexpr (std::is_same_v<decltype(fn(val, output)), Status>) {
    return fn(val, output);
  } else {
    fn(val, output);
    return ::absl::OkStatus();
  }
}

{% for name, accessor in accessors %}
{% set id = loop.index0 %}
constexpr auto accessor_lambda_{{ id }} = {{ accessor.lambda_str }}(
    std::decay<Output>());
using accessor_lambda_{{ id }}_result_t = accessor_lambda_result_t<
    decltype(accessor_lambda_{{ id }})>;
{%- endfor %}{# accessors_list #}

using AccessorSetterFn = Status (*)(ConstFramePtr, size_t, Output*);
constexpr AccessorSetterFn kAccessorSetters[] = {
{%- for id in range(accessors | length) %}
    +[](ConstFramePtr frame, size_t offset, Output* output) -> Status {
      return CallAccessor(accessor_lambda_{{ id }}, frame, offset, output);
    },
{%- endfor %}
};

struct SlotListenerLambdaCaller {
  struct BoundAccessor {
    size_t offset;
    AccessorSetterFn setter_fn;
  };
  std::vector<BoundAccessor> bound_accessors;

  Status operator()(ConstFramePtr frame, Output* output) const {
    for (const auto& accessor : bound_accessors) {
      RETURN_IF_ERROR(accessor.setter_fn(frame, accessor.offset, output));
    }
    return ::absl::OkStatus();
  }
};

class Listener final : public ::arolla::StaticSlotListener<Output> {
 public:
  Listener()
    :StaticSlotListener(
{%- filter indent(width=8) %}
{{ type_in_order_vector(
  accessors|map(attribute=0)|list,
  'accessor_lambda_{}_result_t')
}}
{%- endfilter %}) {}

 private:
  StatusOr<BoundSlotListener<Output>> BindImpl(
      // The slots corresponding to this SlotListener's inputs.
      const absl::flat_hash_map<std::string, TypedSlot>& input_slots)
      const override {
    ASSIGN_OR_RETURN(
        std::vector<std::optional<TypedSlot>> input_slots_in_order,
        ::arolla::MaybeFindSlotsAndVerifyTypes(types_in_order(), input_slots));
    SlotListenerLambdaCaller fn;
    for (size_t i = 0; i != {{ accessors | length }}; ++i) {
      if (auto slot = input_slots_in_order[i]; slot.has_value()) {
        fn.bound_accessors.push_back(
            {slot->byte_offset(), kAccessorSetters[i]});
      }
    }
    return fn;
  }
};

{%- endmacro -%} {# accessors_listener #}
